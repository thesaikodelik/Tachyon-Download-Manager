{
  "manifest_version": 3,
  "name": "Tachyon Download Manager Integration",
  "short_name": "Tachyon",
  "version": "0.1.0",
  "description": "Send links and browser downloads to the Tachyon download manager.",
  "permissions": [
    "contextMenus",
    "downloads",
    "cookies",
    "storage",
    "alarms",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Tachyon",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/bolt-16.png",
      "32": "icons/bolt-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tachyon-download-manager@thesaikodelik",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/bolt-16.png",
    "32": "icons/bolt-32.png",
    "48": "icons/bolt-48.png",
    "128": "icons/bolt-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page.js",
        "video.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
